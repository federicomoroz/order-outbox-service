# URLs que el NAVEGADOR usa para llegar a cada servicio. Se resuelven en tiempo de build de
# Vite (quedan horneadas en el bundle), no en runtime del contenedor: por eso docker-compose.yml
# las pasa como `build.args` y no como `environment`.
#
# Tienen que ser alcanzables desde la maquina del visitante, no desde adentro de la red de
# Docker — `http://order-service:8006` NO sirve aca.

VITE_ORDER_API_URL=http://localhost:8006
VITE_NOTIFICATION_API_URL=http://localhost:8007
